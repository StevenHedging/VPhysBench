{
  "schema_version": "3.0",
  "baseline_id": "wan22_g15_sparse_motion_r32_e20",
  "baseline_version": "1.0.0",
  "implementation": {
    "kind": "command",
    "protocol": "physbench-baseline-v1",
    "entrypoint": ["{python}", "plugin/main.py"],
    "fingerprint_paths": ["plugin/*.py", "provenance/*.json"]
  },
  "description": "Frozen G15 WAN2.2-TI2V-5B sparse-motion LoRA; diagnostic direct-eval baseline with explicit benchmark-overlap audit.",
  "supported_scenes": [
    "pendulum",
    "free_fall",
    "collision_1d",
    "inclined_plane_slide",
    "uniform_circular_motion"
  ],
  "capabilities": {
    "task_families": ["direct_eval"],
    "conditioning": ["generic", "physics"],
    "train": false,
    "finetune": false,
    "generate": true
  },
  "model": {
    "base_model": "WAN2.2-TI2V-5B",
    "adapter": "LoRA-r32-qkv-o-ffn",
    "frozen_lora_checkpoint": null,
    "checkpoint_sha256": "cd19f851133c8370def00991fa778a3bfb581e35713842438ba068495912906f",
    "checkpoint_step": 2840,
    "training_recipe": "20 epochs, sparse tube FlowMatch boost=1.0, five-scene corpus",
    "evaluation_eligibility": {
      "classification": "diagnostic_pretrained",
      "official_comparable": false,
      "reason": "The frozen training corpus overlaps benchmark v3 source trials; see provenance/benchmark_overlap_v3.json."
    }
  },
  "runtime": {
    "project_root": ".",
    "python": "python",
    "model_base": "models",
    "cuda_visible_devices": "0",
    "accelerate_config": null,
    "diffsynth_commit": "fb337fbb90945ff829de69dbd44ded618f73e889"
  },
  "components": {
    "task_builder": {
      "type": "wan22_task_builder_v1",
      "config": {
        "data_adapter": {
          "spatial": {
            "type": "wan22_spatial_v1",
            "width": 480,
            "height": 832,
            "policy": "scene_aspect_ratio_bucket_then_fit_and_pad",
            "pad_color": "black",
            "aspect_ratio_buckets": {
              "enabled": true,
              "buckets": {
                "portrait": {
                  "width": 480,
                  "height": 832,
                  "scene_ids": [
                    "pendulum",
                    "free_fall",
                    "uniform_circular_motion"
                  ]
                },
                "landscape": {
                  "width": 832,
                  "height": 480,
                  "scene_ids": [
                    "collision_1d",
                    "inclined_plane_slide"
                  ]
                }
              }
            }
          },
          "temporal": {
            "type": "wan22_temporal_v1",
            "fps": 24,
            "max_frames": 121,
            "min_frames": 5,
            "policy": "physical-time prefix; preserve valid 4n+1 frame counts"
          },
          "paradigm": {
            "type": "wan22_i2v_input_v1",
            "mode": "i2v",
            "first_frame_policy": "use_asset_or_extract_reference_frame0"
          },
          "text": {
            "type": "wan22_scene_process_text_v1",
            "profile_set": "five_scene_i2v_v1",
            "generic_profile": "generic",
            "detailed_physics_forbidden": true
          },
          "physics": {
            "type": "wan22_structured_physics_injection_v1",
            "strategy": "append_structured_values_to_text",
            "native_target": "native_inputs.text.prompt",
            "physics_profile": "physics"
          },
          "cache": {
            "policy": "content_addressed_shared_immutable"
          }
        }
      }
    },
    "predictor": {
      "type": "wan22_ti2v_v1",
      "config": {
        "num_inference_steps": 50,
        "cfg_scale": 5.0,
        "lora_alpha": 1.0,
        "tiled": true,
        "quality": 5,
        "negative_prompt": "camera shake, changing apparatus identity, discontinuous motion, flicker, blur, text, watermark, low quality"
      }
    }
  }
}
