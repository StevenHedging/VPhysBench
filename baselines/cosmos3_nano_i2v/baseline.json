{
  "schema_version": "3.0",
  "baseline_id": "cosmos3_nano_i2v",
  "baseline_version": "1.0.0",
  "implementation": {
    "kind": "command",
    "protocol": "physbench-baseline-v1",
    "entrypoint": ["{python}", "plugin/main.py"],
    "fingerprint_paths": ["plugin/*.py"]
  },
  "description": "NVIDIA Cosmos3-Nano base image-to-video direct-evaluation baseline.",
  "supported_scenes": [
    "pendulum",
    "free_fall",
    "collision_1d",
    "inclined_plane_slide",
    "uniform_circular_motion"
  ],
  "capabilities": {
    "task_families": ["direct_eval"],
    "conditioning": ["generic", "physics"],
    "train": false,
    "finetune": false,
    "generate": true
  },
  "model": {
    "model_id": "nvidia/Cosmos3-Nano",
    "variant": "base_pretrained",
    "checkpoint": null,
    "snapshot_revision": "411f42a8fdfb8c5b2583cb8786e0938f49796eaa",
    "identity_files": {
      "config.json": "c32f2468a54542c21946bc8eab6172b911dcec9a7193a94c023ea2d4073bcda6",
      "model.safetensors.index.json": "43bdea0b60472d7b4f74f280d5eb508ec5e895f24287af8d2ecf2d0e2738708f"
    }
  },
  "runtime": {
    "framework_root": ".",
    "python": "python",
    "torchrun": "torchrun",
    "hf_home": "cache/huggingface",
    "uv_cache_dir": "cache/uv",
    "cuda_visible_devices": "0,1,2,3",
    "parallelism_preset": "throughput",
    "offline": true,
    "guardrails": false,
    "compile": false,
    "cosmos_commit": "7c22d8aa2e97adcd7857399d1ff1b088be1ff401"
  },
  "components": {
    "task_builder": {
      "type": "cosmos3_nano_i2v_task_builder_v1",
      "config": {
        "data_adapter": {
          "spatial": {
            "type": "cosmos3_resolution_aspect_token_v1",
            "policy": "scene_profile_then_native_cosmos_preprocessor",
            "scene_profiles": {
              "pendulum": {
                "resolution": 480,
                "aspect_ratio": "9,16"
              },
              "free_fall": {
                "resolution": 480,
                "aspect_ratio": "9,16"
              },
              "collision_1d": {
                "resolution": 480,
                "aspect_ratio": "16,9"
              },
              "inclined_plane_slide": {
                "resolution": 480,
                "aspect_ratio": "16,9"
              },
              "uniform_circular_motion": {
                "resolution": 480,
                "aspect_ratio": "4,3"
              }
            }
          },
          "temporal": {
            "type": "cosmos3_fixed_timeline_v1",
            "fps": 24,
            "num_frames": 121,
            "policy": "fixed 5-second generation; evaluator owns timeline alignment"
          },
          "paradigm": {
            "type": "cosmos3_image2video_v1",
            "mode": "image2video",
            "first_frame_policy": "require immutable assets.first_frame"
          },
          "text": {
            "type": "cosmos3_scene_process_text_v1",
            "profile_set": "five_scene_i2v_v1",
            "generic_profile": "generic",
            "detailed_physics_forbidden": true
          },
          "physics": {
            "type": "cosmos3_structured_physics_injection_v1",
            "strategy": "append_structured_values_to_text",
            "native_target": "native_inputs.text.prompt",
            "physics_profile": "physics"
          }
        }
      }
    },
    "predictor": {
      "type": "cosmos3_nano_i2v_v1",
      "config": {
        "num_inference_steps": 35,
        "guidance": 6.0,
        "shift": 10.0,
        "negative_prompt": "camera movement, zoom, scene change, extra objects, missing objects, changing object size, deformation, floating objects, interpenetration, physically implausible motion, flicker, blur, texture drift"
      }
    }
  }
}
