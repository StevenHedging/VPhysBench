{
  "schema_version": "5.0",
  "baseline_id": "cosmos3_nano_i2v_physics",
  "baseline_version": "2.0.0",
  "implementation": {
    "kind": "managed",
    "driver": "driver.py",
    "fingerprint_paths": []
  },
  "description": "NVIDIA Cosmos3-Nano base I2V baseline that appends annotated structured physics to each Case's canonical prompt.",
  "supported_scenes": [
    "pendulum",
    "free_fall",
    "collision_1d",
    "inclined_plane_slide",
    "uniform_circular_motion"
  ],
  "capabilities": {
    "task_families": ["direct_eval"],
    "generation_modes": ["i2v"],
    "train": false,
    "finetune": false,
    "generate": true
  },
  "input_policy": {
    "schema_version": "1.0",
    "case_view": "conditionable_case_v1",
    "text": {
      "source": "case.text.prompt",
      "usage": "required"
    },
    "physics": {
      "source": "case.physics[annotated=true]",
      "usage": "required",
      "representations": ["structured_text"]
    }
  },
  "model": {
    "model_id": "nvidia/Cosmos3-Nano",
    "variant": "base_pretrained",
    "checkpoint": null,
    "snapshot_revision": "411f42a8fdfb8c5b2583cb8786e0938f49796eaa",
    "identity_files": {
      "config.json": "c32f2468a54542c21946bc8eab6172b911dcec9a7193a94c023ea2d4073bcda6",
      "model.safetensors.index.json": "43bdea0b60472d7b4f74f280d5eb508ec5e895f24287af8d2ecf2d0e2738708f"
    }
  },
  "runtime": {
    "framework_root": ".",
    "python": "python",
    "torchrun": "torchrun",
    "hf_home": "cache/huggingface",
    "uv_cache_dir": "cache/uv",
    "cuda_visible_devices": "0,1,2,3",
    "gpus_per_worker": 4,
    "parallelism_preset": "throughput",
    "offline": true,
    "guardrails": false,
    "compile": false,
    "cosmos_commit": "7c22d8aa2e97adcd7857399d1ff1b088be1ff401"
  },
  "adapter": {
    "kind": "standard",
    "preset": "standard_i2v_v1",
    "first_frame_policy": "require_asset",
    "physics_transform": {
      "type": "append_structured_text_v1",
      "template_set": "five_scene_physics_clauses_v1"
    },
    "spatial": {
      "type": "cosmos3_resolution_aspect_token_v1",
      "policy": "scene_profile_then_native_cosmos_preprocessor",
      "scene_profiles": {
        "pendulum": {
          "resolution": 480,
          "aspect_ratio": "9,16"
        },
        "free_fall": {
          "resolution": 480,
          "aspect_ratio": "9,16"
        },
        "collision_1d": {
          "resolution": 480,
          "aspect_ratio": "16,9"
        },
        "inclined_plane_slide": {
          "resolution": 480,
          "aspect_ratio": "16,9"
        },
        "uniform_circular_motion": {
          "resolution": 480,
          "aspect_ratio": "4,3"
        }
      }
    },
    "temporal": {
      "type": "cosmos3_fixed_timeline_v1",
      "fps": 24,
      "num_frames": 121,
      "valid_frame_rule": "4n+1",
      "policy": "fixed 5-second generation; evaluator owns timeline alignment"
    }
  },
  "runner": {
    "type": "cosmos3_nano_i2v_v1",
    "config": {
      "num_inference_steps": 35,
      "guidance": 6.0,
      "shift": 10.0,
      "negative_prompt": "camera movement, zoom, scene change, extra objects, missing objects, changing object size, deformation, floating objects, interpenetration, physically implausible motion, flicker, blur, texture drift"
    }
  }
}
