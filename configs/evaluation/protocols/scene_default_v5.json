{
  "$schema": "../../../schemas/v2/evaluation_protocol.schema.json",
  "schema_version": "1.0",
  "protocol_id": "scene_default_v5",
  "description": "Shadow open-world object-centric evaluation with manifest-declared N-body collision identities, continuous distance, residual discovery, and exposure-integrated cardinality penalties.",
  "robustness": {
    "prediction_record_failure_policy": "evaluated_zero",
    "prediction_media_failure_policy": "evaluated_zero",
    "prediction_observation_failure_policy": "evaluated_zero",
    "reference_failure_policy": "unavailable",
    "internal_failure_policy": "error"
  },
  "scenes": {
    "pendulum": {
      "type": "pendulum_state_v3",
      "evaluator_contract": "robust_subject_v3",
      "timeline": {
        "fps": 16.0,
        "maximum_duration_s": 5.0,
        "minimum_duration_s": 4.8,
        "minimum_source_fps": 8.0,
        "duration_tolerance_s": 0.02,
        "decode_policy": "sequential_forward"
      },
      "spatial": {
        "width": 480,
        "height": 832,
        "policy": "preserve_aspect_ratio_letterbox",
        "pad_value": 0
      },
      "sam2": {
        "model_id": "facebook/sam2.1-hiera-tiny",
        "device": "auto"
      },
      "motion_proposal": {
        "threshold": 15.0,
        "min_area": 20,
        "box_expand": 1.08,
        "min_box_side": 24
      },
      "quality": {
        "minimum_mask_pixels": 20,
        "minimum_mask_area_ratio": 0.00005,
        "maximum_mask_area_ratio": 0.25,
        "minimum_valid_frame_ratio": 0.9
      },
      "period": {
        "minimum_s": 0.3,
        "maximum_s": 2.5
      },
      "scoring": {
        "minimum_angle_scale_deg": 5.0,
        "pivot_drift_scale": 0.03,
        "length_cv_scale": 0.05,
        "weights": {
          "angle_trajectory": 0.6,
          "period": 0.2,
          "amplitude": 0.1,
          "structural_consistency": 0.1
        }
      },
      "subject_scoring": {
        "minimum_observed_pixels": 4,
        "position_distance_scale": 0.08,
        "canonical_crop_size": 64,
        "boundary_tolerance_px": 2,
        "weights": {
          "position": 0.5,
          "shape": 0.2,
          "appearance": 0.3
        },
        "case_weights": {
          "physics_state": 0.4,
          "subject": 0.6
        },
        "parent_weights": {
          "physics_state": 0.7,
          "conditioned_appearance": 0.3
        }
      }
    },
    "collision_1d": {
      "type": "collision_1d_state_v5",
      "evaluator_contract": "robust_subject_v3",
      "timeline": {
        "fps": 16.0,
        "maximum_duration_s": 5.0,
        "minimum_duration_s": 1.5,
        "minimum_source_fps": 8.0,
        "duration_tolerance_s": 0.02,
        "decode_policy": "sequential_forward"
      },
      "spatial": {
        "width": 960,
        "height": 540,
        "policy": "preserve_aspect_ratio_letterbox",
        "pad_value": 0
      },
      "sam2": {
        "model_id": "facebook/sam2.1-hiera-tiny",
        "device": "auto"
      },
      "multi_frame_observation": {
        "track_top_ratio": 0.74,
        "track_bottom_ratio": 0.93,
        "blur_kernel": 5,
        "blur_sigma": 1.2,
        "hough_dp": 1.2,
        "edge_threshold": 100.0,
        "hough_accumulator_thresholds": [30, 26, 22, 18, 14],
        "minimum_circle_radius_px": 5,
        "maximum_circle_radius_px": 28,
        "minimum_circle_center_distance_px": 12,
        "circle_nms_overlap_distance_factor": 0.55,
        "maximum_candidates": 18,
        "maximum_entity_y_spread_px": 32.0,
        "maximum_radius_ratio": 4.5,
        "maximum_seed_fraction": 0.6,
        "maximum_seed_frames": 12,
        "motion_difference_threshold": 18,
        "motion_minimum_area": 20,
        "box_expand": 1.5,
        "minimum_box_side": 24,
        "residual_maximum_gap_s": 0.25,
        "residual_maximum_assignment_cost": 4.0,
        "residual_minimum_radius_ratio": 0.4,
        "residual_maximum_radius_ratio": 2.5,
        "residual_direct_duplicate_center_fraction": 0.8,
        "residual_hough_confirmation_frames": 3,
        "residual_motion_confirmation_frames": 3,
        "residual_motion_minimum_displacement_radius_ratio": 2.0,
        "maximum_residual_tracks": 32
      },
      "quality": {
        "minimum_mask_pixels": 12,
        "maximum_mask_area_ratio": 0.02,
        "minimum_valid_frame_ratio": 0.6,
        "minimum_reference_valid_frame_ratio": 0.2,
        "minimum_prediction_valid_frame_ratio": 0.0,
        "maximum_centroid_jump_px": 120.0,
        "minimum_motion_span_px": 30.0,
        "velocity_window_fraction": 0.2
      },
      "scoring": {
        "trajectory_error_scale": 0.12,
        "event_time_error_scale": 0.1,
        "velocity_error_scale": 0.25,
        "momentum_residual_scale": 0.2,
        "restitution_error_scale": 0.25,
        "cross_track_scale": 0.03,
        "weights": {
          "instance_trajectories": 0.45,
          "contact_event_time": 0.15,
          "pre_post_velocities": 0.2,
          "collision_physics": 0.15,
          "one_dimensional_constraint": 0.05
        }
      },
      "nbody_extraction": {
        "contact_tolerance_radius_fraction": 0.15,
        "contact_hysteresis_radius_fraction": 0.1,
        "minimum_contact_speed_px_s": 0.0,
        "minimum_event_confidence": 0.05,
        "velocity_window_frames": 2
      },
      "nbody_scoring": {
        "along_scale_radius_fraction": 2.0,
        "along_scale_diagonal_fraction": 0.02,
        "normal_scale_radius_fraction": 1.0,
        "normal_scale_diagonal_fraction": 0.01,
        "position_jitter_radius_fraction": 0.05,
        "event_time_duration_fraction": 0.04,
        "event_gap_radius_fraction": 0.25,
        "velocity_error_scale_fraction": 0.25,
        "minimum_velocity_scale_px_s": 1.0,
        "momentum_error_scale_fraction": 0.2,
        "minimum_momentum_scale_kg_px_s": 0.000001,
        "excess_penetration_scale": 0.05,
        "position_weight": 0.3,
        "contact_weight": 0.25,
        "velocity_weight": 0.2,
        "momentum_weight": 0.15,
        "nonpenetration_weight": 0.1
      },
      "subject_scoring": {
        "minimum_observed_pixels": 4,
        "position_distance_scale": 0.08,
        "canonical_crop_size": 64,
        "boundary_tolerance_px": 2,
        "weights": {
          "position": 0.5,
          "shape": 0.2,
          "appearance": 0.3
        },
        "case_weights": {
          "physics_state": 0.4,
          "subject": 0.6
        },
        "parent_weights": {
          "physics_state": 0.7,
          "conditioned_appearance": 0.3
        }
      },
      "object_centric_scoring": {
        "assignment": {
          "minimum_match_position_similarity": 0.1
        },
        "content_weights": {
          "nbody_physics": 0.6,
          "shape": 0.2,
          "appearance": 0.2
        }
      },
      "visualization": {
        "enabled": true,
        "external_root": "/mnt/nvme1/physics_video_benchmark/evaluation_visualizations",
        "external_root_env": "PHYSBENCH_VISUALIZATION_ROOT",
        "repository_link": "visualizations",
        "namespace": "scene_default_v5",
        "fps": 16.0,
        "panel_width": 640,
        "panel_height": 360
      }
    },
    "free_fall": {
      "type": "free_fall_state_v2",
      "evaluator_contract": "robust_subject_v3",
      "timeline": {
        "fps": 32.0,
        "maximum_duration_s": 1.0,
        "minimum_duration_s": 0.2,
        "minimum_source_fps": 8.0,
        "duration_tolerance_s": 0.02,
        "decode_policy": "sequential_forward"
      },
      "spatial": {
        "width": 480,
        "height": 832,
        "policy": "preserve_aspect_ratio_letterbox",
        "pad_value": 0
      },
      "sam2": {
        "model_id": "facebook/sam2.1-hiera-tiny",
        "device": "auto"
      },
      "motion_proposal": {
        "threshold": 12.0,
        "minimum_area": 12,
        "box_expand": 1.35,
        "minimum_box_side": 24
      },
      "quality": {
        "minimum_mask_pixels": 12,
        "maximum_mask_area_ratio": 0.08,
        "minimum_valid_frame_ratio": 0.7,
        "minimum_vertical_span_px": 8.0
      },
      "scoring": {
        "trajectory_error_scale": 0.15,
        "acceleration_error_scale": 0.35,
        "impact_time_error_scale": 0.15,
        "horizontal_drift_scale": 0.08,
        "weights": {
          "vertical_trajectory": 0.5,
          "normalized_acceleration": 0.25,
          "impact_time": 0.15,
          "motion_constraints": 0.1
        }
      },
      "subject_scoring": {
        "minimum_observed_pixels": 4,
        "position_distance_scale": 0.08,
        "canonical_crop_size": 64,
        "boundary_tolerance_px": 2,
        "weights": {
          "position": 0.5,
          "shape": 0.2,
          "appearance": 0.3
        },
        "case_weights": {
          "physics_state": 0.4,
          "subject": 0.6
        },
        "parent_weights": {
          "physics_state": 0.7,
          "conditioned_appearance": 0.3
        }
      }
    },
    "inclined_plane_slide": {
      "type": "inclined_plane_state_v2",
      "evaluator_contract": "robust_subject_v3",
      "timeline": {
        "fps": 16.0,
        "maximum_duration_s": 5.0,
        "minimum_duration_s": 1.0,
        "minimum_source_fps": 8.0,
        "duration_tolerance_s": 0.02,
        "decode_policy": "sequential_forward"
      },
      "spatial": {
        "width": 640,
        "height": 480,
        "policy": "preserve_aspect_ratio_letterbox",
        "pad_value": 0
      },
      "sam2": {
        "model_id": "facebook/sam2.1-hiera-tiny",
        "device": "auto"
      },
      "motion_proposal": {
        "threshold": 12.0,
        "minimum_area": 18,
        "box_expand": 1.25,
        "minimum_box_side": 28
      },
      "quality": {
        "minimum_mask_pixels": 20,
        "maximum_mask_area_ratio": 0.15,
        "minimum_valid_frame_ratio": 0.75,
        "minimum_motion_span_px": 16.0
      },
      "scoring": {
        "trajectory_error_scale": 0.18,
        "acceleration_error_scale": 0.4,
        "descent_time_error_scale": 0.18,
        "cross_track_scale": 0.05,
        "orientation_std_scale_deg": 12.0,
        "weights": {
          "along_plane_trajectory": 0.5,
          "normalized_acceleration": 0.25,
          "descent_time": 0.15,
          "contact_and_pose_constraints": 0.1
        }
      },
      "subject_scoring": {
        "minimum_observed_pixels": 4,
        "position_distance_scale": 0.08,
        "canonical_crop_size": 64,
        "boundary_tolerance_px": 2,
        "weights": {
          "position": 0.5,
          "shape": 0.2,
          "appearance": 0.3
        },
        "case_weights": {
          "physics_state": 0.4,
          "subject": 0.6
        },
        "parent_weights": {
          "physics_state": 0.7,
          "conditioned_appearance": 0.3
        }
      }
    },
    "uniform_circular_motion": {
      "type": "uniform_circular_motion_state_v2",
      "evaluator_contract": "robust_subject_v3",
      "timeline": {
        "fps": 8.0,
        "maximum_duration_s": 5.0,
        "minimum_duration_s": 3.0,
        "minimum_source_fps": 8.0,
        "duration_tolerance_s": 0.02,
        "decode_policy": "sequential_forward"
      },
      "spatial": {
        "width": 640,
        "height": 480,
        "policy": "preserve_aspect_ratio_letterbox",
        "pad_value": 0
      },
      "color_observation": {
        "green_hsv_lower": [35, 35, 25],
        "green_hsv_upper": [100, 255, 255],
        "disk_erosion_kernel": 11,
        "minimum_disk_area_ratio": 0.05,
        "minimum_component_area": 6,
        "maximum_component_area_ratio": 0.03,
        "minimum_valid_frame_ratio": 0.9,
        "maximum_candidates": 8
      },
      "scoring": {
        "angular_trajectory_scale_rad": 0.35,
        "angular_velocity_error_scale": 0.25,
        "radial_cv_scale": 0.08,
        "angular_fit_rmse_scale_rad": 0.2,
        "radius_configuration_scale": 0.12,
        "weights": {
          "angular_trajectory": 0.5,
          "angular_velocity": 0.25,
          "orbit_geometry": 0.15,
          "uniform_motion": 0.1
        }
      },
      "subject_scoring": {
        "minimum_observed_pixels": 4,
        "position_distance_scale": 0.08,
        "canonical_crop_size": 64,
        "boundary_tolerance_px": 2,
        "weights": {
          "position": 0.5,
          "shape": 0.2,
