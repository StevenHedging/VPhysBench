{
  "schema_version": "1.0",
  "baseline_id": "wan22_ti2v_5b_lora_three_scene_r32_8gpu_buckets",
  "adapter": "wan22_lora",
  "input_view": "auto_i2v_from_case_or_video",
  "capabilities": {"train": false, "finetune": true, "generate": true},
  "supported_scenes": ["pendulum", "free_fall", "collision_1d"],
  "require_image_condition": true,
  "require_lora_checkpoint": true,
  "initial_lora_checkpoint": null,
  "runtime": {
    "project_root": "/root/Steven/wan22_pendulum_pipeline",
    "python": "/root/miniconda3/envs/dlp/bin/python",
    "model_base": "/root/Steven/wan22_pendulum_pipeline/models",
    "cuda_visible_devices": "0,1,2,3,4,5,6,7",
    "accelerate_config": "/root/Steven/wan22_pendulum_pipeline/configs/accelerate/lora_8gpu.yaml",
    "diffsynth_commit": "fb337fbb90945ff829de69dbd44ded618f73e889"
  },
  "media_adapter": {
    "width": 480,
    "height": 832,
    "fps": 24,
    "max_frames": 121,
    "min_frames": 5,
    "spatial_policy": "scene_aspect_ratio_bucket_then_fit_and_pad",
    "temporal_policy": "physical-time prefix; preserve each case's valid 4n+1 frame count without looping",
    "pad_color": "black",
    "aspect_ratio_buckets": {
      "enabled": true,
      "buckets": {
        "portrait": {
          "width": 480,
          "height": 832,
          "scene_ids": ["pendulum", "free_fall"]
        },
        "landscape": {
          "width": 832,
          "height": 480,
          "scene_ids": ["collision_1d"]
        }
      }
    }
  },
  "lora": {
    "algorithm": "FlowMatch SFT + LoRA",
    "rank": 32,
    "target_modules": "q,k,v,o,ffn.0,ffn.2",
    "learning_rate": 0.0001,
    "dataset_repeat": 4,
    "num_epochs": 10,
    "save_steps": 41,
    "scene_balancing": "oversample_each_scene_to_largest",
    "gradient_accumulation": 1,
    "num_workers": 4,
    "seed": 42,
    "precision": "bf16",
    "gradient_checkpointing": true,
    "optimizer": "AdamW",
    "scheduler": "ConstantLR",
    "weight_decay": 0.01
  },
  "generation": {
    "num_inference_steps": 50,
    "cfg_scale": 5.0,
    "lora_alpha": 1.0,
    "tiled": true,
    "quality": 5,
    "negative_prompt": "camera shake, changing apparatus identity, discontinuous motion, flicker, blur, text, watermark, low quality"
  },
  "description": "Eight-GPU, scene-balanced WAN2.2-TI2V-5B LoRA with portrait buckets for pendulum/free fall and a landscape bucket for 1D collision."
}
