{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen reference observation manifest",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "scene_id",
    "source",
    "generator",
    "timeline",
    "quality",
    "entities"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"$ref": "#/$defs/safeId"},
    "scene_id": {"$ref": "#/$defs/safeId"},
    "source": {
      "type": "object",
      "required": ["reference_video", "first_frame_mask_manifest"],
      "properties": {
        "reference_video": {"$ref": "#/$defs/fileRecord"},
        "first_frame_mask_manifest": {"$ref": "#/$defs/fileRecord"}
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": ["id", "code_revision", "model_id", "config_fingerprint"],
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "code_revision": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "config_fingerprint": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "timeline": {"$ref": "#/$defs/fileRecord"},
    "quality": {"$ref": "#/$defs/fileRecord"},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["object_id", "mask_id", "mask_tube", "trajectory"],
        "properties": {
          "object_id": {"pattern": "^object_[1-9][0-9]*$", "type": "string"},
          "mask_id": {"pattern": "^[0-9]{2,}$", "type": "string"},
          "mask_tube": {"$ref": "#/$defs/fileRecord"},
          "trajectory": {"$ref": "#/$defs/fileRecord"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "fileRecord": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/assetPath"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
