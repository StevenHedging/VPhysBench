{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen reference observation automatic quality report",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "status",
    "config_fingerprint",
    "checks",
    "entities",
    "failures",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"$ref": "#/$defs/safeId"},
    "status": {"enum": ["pass", "warning", "fail"]},
    "config_fingerprint": {"$ref": "#/$defs/sha256"},
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "entities": {
      "type": "object",
      "patternProperties": {
        "^object_[1-9][0-9]*$": {"type": "object"}
      },
      "additionalProperties": false
    },
    "failures": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue": {
      "type": "object",
      "required": ["code", "status"],
      "properties": {
        "code": {"$ref": "#/$defs/safeId"},
        "status": {"enum": ["pass", "warning", "fail"]},
        "object_id": {"$ref": "#/$defs/safeId"},
        "observation_index": {"type": "integer", "minimum": 0},
        "value": {"type": "number"},
        "threshold": {"type": "number"},
        "message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
