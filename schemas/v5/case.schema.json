{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Materialized symbolic physical-video Case returned by the Dataset Loader",
  "type": "object",
  "required": [
    "case_id",
    "scene_id",
    "text",
    "assets",
    "physics",
    "appearance",
    "temporal"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "text": {
      "type": "object",
      "required": ["prompt"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": [
        "caption",
        "first_frame",
        "physics_annotation",
        "reference_video"
      ],
      "properties": {
        "caption": {"$ref": "#/$defs/assetPath"},
        "first_frame": {"$ref": "#/$defs/assetPath"},
        "first_frame_mask_manifest": {"$ref": "#/$defs/assetPath"},
        "physics_annotation": {"$ref": "#/$defs/assetPath"},
        "reference_video": {"$ref": "#/$defs/assetPath"}
      },
      "additionalProperties": false
    },
    "physics": {},
    "appearance": {
      "type": "object",
      "description": "Non-physics scenario, appearance, environment, setup-form and acquisition metadata."
    },
    "temporal": {"type": "object"}
  },
  "not": {
    "anyOf": [
      {"required": ["ood"]},
      {"required": ["prompt"]},
      {"required": ["input_views"]},
      {"required": ["physical_parameters"]},
      {"required": ["view_a_split"]}
    ]
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"scene_id": {"const": "push_bottle"}},
        "required": ["scene_id"]
      },
      "then": {
        "properties": {"physics": {"$ref": "#/$defs/flatPhysics"}}
      },
      "else": {
        "properties": {"physics": {"$ref": "#/$defs/groupedPhysics"}}
      }
    }
  ],
  "$defs": {
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "flatPhysics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/quantity"}
    },
    "groupedPhysics": {
      "type": "object",
      "required": ["objects", "environment"],
      "properties": {
        "objects": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^object_[1-9][0-9]*$": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"$ref": "#/$defs/quantity"}
            }
          },
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/quantity"}
        }
      },
      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "required": ["value", "unit", "symbol"],
      "properties": {
        "value": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
