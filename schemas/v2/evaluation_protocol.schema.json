{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene-aware evaluation protocol",
  "type": "object",
  "required": ["schema_version", "protocol_id", "description", "scenes"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "protocol_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "robustness": {"$ref": "#/$defs/robustness"},
    "scenes": {
      "type": "object",
      "required": [
        "pendulum",
        "collision_1d",
        "free_fall",
        "inclined_plane_slide",
        "uniform_circular_motion"
      ],
      "properties": {
        "pendulum": {
          "oneOf": [
            {"$ref": "#/$defs/pendulum"},
            {"$ref": "#/$defs/openWorldV2PendulumScene"}
          ]
        },
        "free_fall": {
          "oneOf": [
            {"$ref": "#/$defs/referenceScene"},
            {"$ref": "#/$defs/openWorldV2FreeFallScene"}
          ]
        },
        "inclined_plane_slide": {
          "oneOf": [
            {"$ref": "#/$defs/referenceScene"},
            {"$ref": "#/$defs/openWorldV2InclinedPlaneScene"}
          ]
        },
        "uniform_circular_motion": {
          "oneOf": [
            {"$ref": "#/$defs/referenceScene"},
            {"$ref": "#/$defs/openWorldV2CircularMotionScene"}
          ]
        },
        "collision_1d": {
          "$ref": "#/$defs/referenceScene"
        }
      },
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/referenceScene"},
          {
            "type": "object",
            "required": ["type"],
            "properties": {"type": {"const": "unsupported"}}
          }
        ]
      }
    }
  },
  "$defs": {
    "robustness": {
      "type": "object",
      "required": [
        "prediction_record_failure_policy",
        "prediction_media_failure_policy",
        "prediction_observation_failure_policy",
        "reference_failure_policy",
        "internal_failure_policy"
      ],
      "properties": {
        "prediction_record_failure_policy": {"const": "evaluated_zero"},
        "prediction_media_failure_policy": {"const": "evaluated_zero"},
        "prediction_observation_failure_policy": {"const": "evaluated_zero"},
        "reference_failure_policy": {"const": "unavailable"},
        "internal_failure_policy": {"const": "error"}
      },
      "additionalProperties": false
    },
    "subjectScoring": {
      "type": "object",
      "required": [
        "minimum_observed_pixels",
        "position_distance_scale",
        "canonical_crop_size",
        "boundary_tolerance_px",
        "weights",
        "case_weights",
        "parent_weights"
      ],
      "properties": {
        "minimum_observed_pixels": {"type": "integer", "minimum": 1},
        "position_distance_scale": {"type": "number", "exclusiveMinimum": 0},
        "canonical_crop_size": {"type": "integer", "minimum": 8},
        "boundary_tolerance_px": {"type": "integer", "minimum": 1},
        "weights": {
          "type": "object",
          "required": ["position", "shape", "appearance"],
          "properties": {
            "position": {"type": "number", "minimum": 0},
            "shape": {"type": "number", "minimum": 0},
            "appearance": {"type": "number", "minimum": 0}
          }
        },
        "case_weights": {
          "type": "object",
          "required": ["physics_state", "subject"],
          "properties": {
            "physics_state": {"type": "number", "minimum": 0},
            "subject": {"type": "number", "minimum": 0}
          }
        },
        "parent_weights": {
          "type": "object",
          "required": ["physics_state", "conditioned_appearance"],
          "properties": {
            "physics_state": {"type": "number", "minimum": 0},
            "conditioned_appearance": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "objectCentricScoring": {
      "type": "object",
      "required": ["assignment", "content_weights"],
      "properties": {
        "assignment": {
          "type": "object",
          "required": ["minimum_match_position_similarity"],
          "properties": {
            "minimum_match_position_similarity": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "content_weights": {
          "type": "object",
          "required": ["nbody_physics", "shape", "appearance"],
          "properties": {
            "nbody_physics": {"type": "number", "minimum": 0},
            "shape": {"type": "number", "minimum": 0},
            "appearance": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "openWorldV2Scoring": {
      "type": "object",
      "required": ["assignment", "content_weights"],
      "properties": {
        "assignment": {
          "type": "object",
          "required": ["minimum_match_position_similarity"],
          "properties": {
            "minimum_match_position_similarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maximum_condition_identity_cost": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "initial_window_frames": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "content_weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "polar_distance": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "openWorldV2Visualization": {
      "type": "object",
      "required": [
        "enabled",
        "external_root",
        "repository_link",
        "namespace",
        "fps"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "external_root": {"type": "string", "minLength": 1},
        "external_root_env": {"type": "string", "minLength": 1},
        "repository_link": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "panel_width": {"type": "integer", "minimum": 64},
        "panel_height": {"type": "integer", "minimum": 64}
      },
      "additionalProperties": false
    },
    "openWorldV2Scene": {
      "type": "object",
      "required": [
        "type",
        "observer_protocol",
        "evaluator_contract",
        "timeline",
        "spatial",
        "scoring",
        "subject_scoring",
        "object_centric_scoring",
        "visualization"
      ],
      "properties": {
        "type": {
          "enum": [
            "pendulum_state_v6",
            "pendulum_state_v7",
            "free_fall_state_v6",
            "free_fall_state_v7",
            "inclined_plane_state_v6",
            "inclined_plane_state_v7",
            "uniform_circular_motion_state_v6",
            "uniform_circular_motion_state_v7"
          ]
        },
        "observer_protocol": {"const": "open_world_v2"},
        "evaluator_contract": {"const": "robust_subject_v3"},
        "reference_observation_policy": {
          "enum": [
            "condition_causal_symmetric",
            "apparatus_geometry_symmetric"
          ]
        },
        "timeline": {"$ref": "#/$defs/referenceTimeline"},
        "spatial": {"$ref": "#/$defs/spatial"},
        "sam2": {"type": "object"},
        "motion_proposal": {"type": "object"},
        "color_observation": {"type": "object"},
        "quality": {"type": "object"},
        "period": {"type": "object"},
        "open_world_observation": {"type": "object"},
        "rigid_body_observation": {"type": "object"},
        "topology": {"type": "object"},
        "scoring": {
          "type": "object",
          "required": ["weights"],
          "properties": {"weights": {"type": "object"}}
        },
        "subject_scoring": {"$ref": "#/$defs/subjectScoring"},
        "object_centric_scoring": {
          "$ref": "#/$defs/openWorldV2Scoring"
        },
        "visualization": {
          "$ref": "#/$defs/openWorldV2Visualization"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["pendulum_state_v6", "pendulum_state_v7"]
              }
            }
          },
          "then": {
            "required": [
              "sam2",
              "motion_proposal",
              "quality",
              "period",
              "open_world_observation",
              "topology"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "free_fall_state_v6",
                  "free_fall_state_v7",
                  "inclined_plane_state_v6",
                  "inclined_plane_state_v7"
                ]
              }
            }
          },
          "then": {
            "required": [
              "sam2",
              "motion_proposal",
              "quality",
              "rigid_body_observation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "uniform_circular_motion_state_v6",
                  "uniform_circular_motion_state_v7"
                ]
              }
            }
          },
          "then": {"required": ["color_observation"]}
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "pendulum_state_v7",
                  "free_fall_state_v7",
                  "inclined_plane_state_v7"
                ]
              }
            }
          },
          "then": {
            "required": ["reference_observation_policy"],
            "properties": {
              "reference_observation_policy": {
                "const": "condition_causal_symmetric"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "uniform_circular_motion_state_v7"
              }
            }
          },
          "then": {
            "required": ["reference_observation_policy"],
            "properties": {
              "reference_observation_policy": {
                "const": "apparatus_geometry_symmetric"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "pendulum_state_v6",
                  "free_fall_state_v6",
                  "inclined_plane_state_v6",
                  "uniform_circular_motion_state_v6"
                ]
              }
            }
          },
          "then": {
            "not": {"required": ["reference_observation_policy"]}
          }
        }
      ],
      "additionalProperties": false
    },
    "openWorldV2PendulumScene": {
      "allOf": [
        {"$ref": "#/$defs/openWorldV2Scene"},
        {
          "properties": {
            "type": {
              "enum": ["pendulum_state_v6", "pendulum_state_v7"]
            }
          }
        }
      ]
    },
    "openWorldV2FreeFallScene": {
      "allOf": [
        {"$ref": "#/$defs/openWorldV2Scene"},
        {
          "properties": {
            "type": {
              "enum": ["free_fall_state_v6", "free_fall_state_v7"]
            }
          }
        }
      ]
    },
    "openWorldV2InclinedPlaneScene": {
      "allOf": [
        {"$ref": "#/$defs/openWorldV2Scene"},
        {
          "properties": {
            "type": {
              "enum": [
                "inclined_plane_state_v6",
                "inclined_plane_state_v7"
              ]
            }
          }
        }
      ]
    },
    "openWorldV2CircularMotionScene": {
      "allOf": [
        {"$ref": "#/$defs/openWorldV2Scene"},
        {
          "properties": {
            "type": {
              "enum": [
                "uniform_circular_motion_state_v6",
                "uniform_circular_motion_state_v7"
              ]
            }
          }
        }
      ]
    },
    "nbodyExtraction": {
      "type": "object",
      "required": [
        "contact_tolerance_radius_fraction",
        "contact_hysteresis_radius_fraction",
        "minimum_contact_speed_px_s",
        "minimum_event_confidence",
        "velocity_window_frames"
      ],
      "properties": {
        "contact_tolerance_radius_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "contact_hysteresis_radius_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_contact_speed_px_s": {"type": "number", "minimum": 0},
        "minimum_event_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "velocity_window_frames": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "nbodyScoring": {
      "type": "object",
      "required": [
        "along_scale_radius_fraction",
        "along_scale_diagonal_fraction",
        "normal_scale_radius_fraction",
        "normal_scale_diagonal_fraction",
        "position_jitter_radius_fraction",
        "event_time_duration_fraction",
        "event_gap_radius_fraction",
        "velocity_error_scale_fraction",
        "minimum_velocity_scale_px_s",
        "momentum_error_scale_fraction",
        "minimum_momentum_scale_kg_px_s",
        "excess_penetration_scale",
        "position_weight",
        "contact_weight",
        "velocity_weight",
        "momentum_weight",
        "nonpenetration_weight"
      ],
      "properties": {
        "along_scale_radius_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "along_scale_diagonal_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "normal_scale_radius_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "normal_scale_diagonal_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "position_jitter_radius_fraction": {
          "type": "number",
          "minimum": 0
        },
        "event_time_duration_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "event_gap_radius_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "velocity_error_scale_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_velocity_scale_px_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "momentum_error_scale_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_momentum_scale_kg_px_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "excess_penetration_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "position_weight": {"type": "number", "minimum": 0},
        "contact_weight": {"type": "number", "minimum": 0},
        "velocity_weight": {"type": "number", "minimum": 0},
        "momentum_weight": {"type": "number", "minimum": 0},
        "nonpenetration_weight": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "spatial": {
      "type": "object",
      "required": ["width", "height", "policy"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "policy": {"const": "preserve_aspect_ratio_letterbox"},
        "pad_value": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "referenceTimeline": {
      "type": "object",
      "required": [
        "fps",
        "maximum_duration_s",
        "minimum_duration_s",
        "minimum_source_fps"
      ],
      "properties": {
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "maximum_duration_s": {"type": "number", "exclusiveMinimum": 0},
        "minimum_duration_s": {"type": "number", "exclusiveMinimum": 0},
        "minimum_source_fps": {"type": "number", "exclusiveMinimum": 0},
        "duration_tolerance_s": {"type": "number", "minimum": 0},
        "decode_policy": {
          "enum": ["legacy_random_seek", "sequential_forward"]
        }
      }
    },
    "fixedTimeline": {
      "type": "object",
      "required": ["fps", "duration_s", "minimum_source_fps"],
      "properties": {
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "minimum_source_fps": {"type": "number", "exclusiveMinimum": 0},
        "duration_tolerance_s": {"type": "number", "minimum": 0},
        "decode_policy": {
          "enum": ["legacy_random_seek", "sequential_forward"]
        }
      }
    },
    "referenceScene": {
      "type": "object",
      "required": ["type", "timeline", "spatial", "scoring"],
      "properties": {
        "type": {
          "enum": [
            "free_fall_state_v1",
            "free_fall_state_v2",
            "inclined_plane_state_v1",
            "inclined_plane_state_v2",
            "uniform_circular_motion_state_v1",
            "uniform_circular_motion_state_v2",
            "collision_1d_state_v1",
            "collision_1d_state_v2",
            "collision_1d_state_v3",
            "collision_1d_state_v5"
          ]
        },
        "timeline": {"$ref": "#/$defs/referenceTimeline"},
        "spatial": {"$ref": "#/$defs/spatial"},
        "evaluator_contract": {"const": "robust_subject_v3"},
        "subject_scoring": {"$ref": "#/$defs/subjectScoring"},
        "sam2": {"type": "object"},
        "multi_frame_observation": {"type": "object"},
        "nbody_extraction": {"$ref": "#/$defs/nbodyExtraction"},
        "nbody_scoring": {"$ref": "#/$defs/nbodyScoring"},
        "object_centric_scoring": {
          "$ref": "#/$defs/objectCentricScoring"
        },
        "quality": {"type": "object"},
        "scoring": {
          "type": "object",
          "required": ["weights"],
          "properties": {"weights": {"type": "object"}}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "free_fall_state_v2",
                  "inclined_plane_state_v2",
                  "uniform_circular_motion_state_v2",
                  "collision_1d_state_v2",
                  "collision_1d_state_v3",
                  "collision_1d_state_v5"
                ]
              }
            }
          },
          "then": {
            "required": ["evaluator_contract", "subject_scoring"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "collision_1d_state_v5"}
            }
          },
          "then": {
            "required": [
              "sam2",
              "multi_frame_observation",
              "quality",
              "nbody_extraction",
              "nbody_scoring",
              "object_centric_scoring"
            ]
          }
        }
      ]
    },
    "pendulum": {
      "type": "object",
      "required": ["type", "timeline", "spatial", "quality", "scoring"],
      "properties": {
        "type": {
          "enum": [
            "pendulum_state_v1",
            "pendulum_state_v2",
            "pendulum_state_v3"
          ]
        },
        "timeline": {"type": "object"},
        "spatial": {"$ref": "#/$defs/spatial"},
        "evaluator_contract": {"const": "robust_subject_v3"},
        "subject_scoring": {"$ref": "#/$defs/subjectScoring"},
        "quality": {"type": "object"},
        "scoring": {
          "type": "object",
          "required": ["weights"],
          "properties": {"weights": {"type": "object"}}
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {"const": "pendulum_state_v1"},
            "timeline": {"$ref": "#/$defs/fixedTimeline"}
          }
        },
        {
          "properties": {
            "type": {"const": "pendulum_state_v2"},
            "timeline": {"$ref": "#/$defs/referenceTimeline"}
          }
        },
        {
          "required": ["evaluator_contract", "subject_scoring"],
          "properties": {
            "type": {"const": "pendulum_state_v3"},
            "timeline": {"$ref": "#/$defs/referenceTimeline"}
          }
        }
      ]
    }
  }
}
