{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sealed Baseline Task Instance",
  "type": "object",
  "required": [
    "schema_version",
    "instance_id",
    "instance_digest",
    "identity",
    "semantics",
    "canonical_plan",
    "source",
    "adaptations",
    "training",
    "inference",
    "execution_graph",
    "cache_bindings",
    "baseline_payload"
  ],
  "properties": {
    "schema_version": {"const": "2.1"},
    "instance_id": {"type": "string", "minLength": 1},
    "instance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "required": [
        "dataset",
        "task",
        "baseline",
        "task_builder",
        "data_adapter",
        "canonical_plan_digest"
      ],
      "properties": {
        "dataset": {
          "type": "object",
          "required": ["dataset_id", "digest"],
          "properties": {
            "dataset_id": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "task": {
          "type": "object",
          "required": ["task_id", "digest"],
          "properties": {
            "task_id": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "baseline": {
          "type": "object",
          "required": [
            "baseline_id",
            "baseline_version",
            "digest",
            "deployment_digest"
          ],
          "properties": {
            "baseline_id": {"type": "string", "minLength": 1},
            "baseline_version": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "deployment_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "task_builder": {
          "type": "object",
          "required": ["type", "fingerprint"],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "data_adapter": {
          "type": "object",
          "required": [
            "fingerprint",
            "materialization_fingerprint"
          ],
          "properties": {
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "materialization_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "canonical_plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "semantics": {
      "type": "object",
      "required": ["family", "conditioning", "scene_ids"]
    },
    "canonical_plan": {"type": "object"},
    "source": {
      "type": "object",
      "required": ["asset_root", "cases"]
    },
    "adaptations": {"type": "array"},
    "training": {"type": ["object", "null"]},
    "inference": {
      "type": "object",
      "required": ["predictor", "jobs"]
    },
    "execution_graph": {
      "type": "object",
      "required": ["operations"]
    },
    "cache_bindings": {"type": "array"},
    "baseline_payload": {
      "description": "Opaque payload interpreted only by the target Baseline",
      "type": "object"
    }
  },
  "additionalProperties": false
}
