{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static Baseline bundle",
  "type": "object",
  "required": ["schema_version", "baseline_id", "plugin", "capabilities", "components"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "baseline_id": {"type": "string"},
    "plugin": {"type": "string"},
    "description": {"type": "string"},
    "supported_scenes": {"type": ["array", "string"]},
    "capabilities": {"type": "object"},
    "model": {"type": "object"},
    "runtime": {"type": "object"},
    "components": {
      "type": "object",
      "required": ["task_builder", "trainer", "predictor"],
      "properties": {
        "task_builder": {
          "type": "object",
          "required": ["type", "config"]
        },
        "trainer": {"type": "object"},
        "predictor": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
