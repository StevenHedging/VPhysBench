{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt-free physical video case",
  "type": "object",
  "required": ["schema_version", "case_id", "scene_id", "assets", "physics", "appearance", "temporal", "provenance", "ood", "has_real_reference_video"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "case_id": {"type": "string"},
    "scene_id": {"type": "string"},
    "assets": {"type": "object"},
    "physics": {"type": "object", "minProperties": 1},
    "appearance": {"type": "object"},
    "temporal": {"type": "object"},
    "alignment": {"type": ["object", "null"]},
    "provenance": {"type": "object"},
    "ood": {"type": "object"},
    "has_real_reference_video": {"type": "boolean"}
  },
  "not": {
    "anyOf": [
      {"required": ["prompt"]},
      {"required": ["text"]},
      {"required": ["input_views"]},
      {"required": ["physical_parameters"]},
      {"required": ["view_a_split"]}
    ]
  },
  "additionalProperties": false
}
