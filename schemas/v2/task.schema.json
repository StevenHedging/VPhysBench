{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atomic benchmark Task",
  "type": "object",
  "required": ["schema_version", "task_id", "family", "conditioning", "dataset_id", "dataset_view", "selection", "ood2", "seeds"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "task_id": {"type": "string"},
    "family": {"enum": ["finetune_eval", "direct_eval"]},
    "conditioning": {"enum": ["generic", "physics"]},
    "dataset_id": {"type": "string"},
    "dataset_view": {"enum": ["view_a", "view_b"]},
    "selection": {"type": "object"},
    "ood2": {"type": "object"},
    "seeds": {
      "type": "object",
      "required": ["training", "inference"]
    },
    "evaluation": {"type": "object"}
  },
  "additionalProperties": false
}
