{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baseline prediction record",
  "type": "object",
  "required": [
    "job_id",
    "case_id",
    "baseline_id",
    "evaluation_partition",
    "status",
    "video_path",
    "seed"
  ],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "evaluation_partition": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "planned",
        "staged",
        "complete",
        "failed",
        "protocol_error"
      ]
    },
    "video_path": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "seed": {"type": "integer"},
    "media_contract": {"$ref": "#/$defs/mediaContract"},
    "media_contract_audit": {"type": "object"},
    "protocol_error": {
      "type": "object",
      "required": ["code", "reason", "boundary"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "boundary": {"const": "managed_prediction_media"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "protocol_error"}},
        "required": ["status"]
      },
      "then": {"required": ["protocol_error"]}
    }
  ],
  "$defs": {
    "frameCount": {
      "oneOf": [
        {
          "type": "object",
          "required": ["rule", "value"],
          "properties": {
            "rule": {"const": "fixed"},
            "value": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["rule", "value", "modulus", "remainder"],
          "properties": {
            "rule": {"const": "fixed"},
            "value": {"type": "integer", "minimum": 1},
            "modulus": {"type": "integer", "minimum": 1},
            "remainder": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["rule", "minimum", "maximum"],
          "properties": {
            "rule": {"const": "bounded"},
            "minimum": {"type": "integer", "minimum": 1},
            "maximum": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "rule",
            "minimum",
            "maximum",
            "modulus",
            "remainder"
          ],
          "properties": {
            "rule": {"const": "bounded"},
            "minimum": {"type": "integer", "minimum": 1},
            "maximum": {"type": "integer", "minimum": 1},
            "modulus": {"type": "integer", "minimum": 1},
            "remainder": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      ]
    },
    "mediaContract": {
      "type": "object",
      "required": [
        "schema_version",
        "policy",
        "conditioning",
        "output",
        "evaluation"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "policy": {"const": "standard_i2v_media_v1"},
        "conditioning": {
          "type": "object",
          "required": ["asset", "transform", "margin_fill"],
          "properties": {
            "asset": {"type": "string", "minLength": 1},
            "transform": {"const": "centered_contain"},
            "margin_fill": {"const": "edge_replicate"}
          },
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "required": ["canvas", "timeline"],
          "properties": {
            "canvas": {
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": {"type": "integer", "minimum": 1},
                "height": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            },
            "timeline": {
              "type": "object",
              "required": ["fps", "start_time_s", "frame_count"],
              "properties": {
                "fps": {"type": "number", "exclusiveMinimum": 0},
                "start_time_s": {"const": 0.0},
                "frame_count": {"$ref": "#/$defs/frameCount"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "evaluation": {
          "type": "object",
          "required": ["spatial_view", "temporal_view"],
          "properties": {
            "spatial_view": {"const": "conditioning_content"},
            "temporal_view": {"const": "physical_time_from_frame_zero"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
