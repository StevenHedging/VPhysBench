{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Self-registering Baseline Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_id",
    "baseline_version",
    "implementation",
    "capabilities"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "baseline_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "baseline_version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "implementation": {
      "type": "object",
      "required": ["kind", "protocol", "entrypoint", "fingerprint_paths"],
      "properties": {
        "kind": {"const": "command"},
        "protocol": {"const": "physbench-baseline-v1"},
        "entrypoint": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "fingerprint_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "supported_scenes": {
      "oneOf": [
        {"const": "all"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "required": ["task_families", "conditioning"],
      "properties": {
        "task_families": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "conditioning": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "train": {"type": "boolean"},
        "finetune": {"type": "boolean"},
        "generate": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "model": {"type": "object"},
    "runtime": {"type": "object"},
    "components": {
      "description": "Opaque Baseline-owned component configuration.",
      "type": "object"
    }
  },
  "additionalProperties": false
}
