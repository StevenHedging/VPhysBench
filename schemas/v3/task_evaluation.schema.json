{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task-level evaluation result",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "task_family",
    "protocol",
    "status",
    "coverage",
    "score"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "task_family": {"enum": ["finetune_eval", "direct_eval"]},
    "protocol": {"type": "object"},
    "status": {"type": "string", "minLength": 1},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "score": {"type": ["number", "null"]},
    "dimensions": {
      "type": "object",
      "required": ["expert", "csti"],
      "properties": {
        "expert": {
          "type": "object",
          "required": ["score", "source"],
          "properties": {
            "score": {"type": ["number", "null"]},
            "source": {"const": "top_level_score"}
          },
          "additionalProperties": false
        },
        "csti": {
          "type": "object",
          "required": [
            "status",
            "score",
            "coverage",
            "by_scene",
            "breakdown"
          ],
          "properties": {
            "status": {
              "enum": ["complete", "partial", "not_applicable"]
            },
            "score": {"type": ["number", "null"]},
            "coverage": {"type": "number", "minimum": 0, "maximum": 1},
            "by_scene": {"type": "object"},
            "breakdown": {"type": "object"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
