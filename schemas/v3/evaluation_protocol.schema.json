{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene-aware evaluation protocol",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "description",
    "scenes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "robustness": {
      "$ref": "#/$defs/robustness"
    },
    "general_metrics": {
      "$ref": "#/$defs/generalMetrics"
    },
    "scenes": {
      "type": "object",
      "required": [
        "pendulum",
        "collision_1d",
        "inclined_plane_slide",
        "uniform_circular_motion",
        "parabolic_motion"
      ],
      "properties": {
        "pendulum": {
          "oneOf": [
            {
              "$ref": "#/$defs/pendulum"
            },
            {
              "$ref": "#/$defs/openWorldV2PendulumScene"
            }
          ]
        },
        "inclined_plane_slide": {
          "oneOf": [
            {
              "$ref": "#/$defs/referenceScene"
            },
            {
              "$ref": "#/$defs/openWorldV2InclinedPlaneScene"
            }
          ]
        },
        "uniform_circular_motion": {
          "oneOf": [
            {
              "$ref": "#/$defs/referenceScene"
            },
            {
              "$ref": "#/$defs/openWorldV2CircularMotionScene"
            }
          ]
        },
        "collision_1d": {
          "$ref": "#/$defs/referenceScene"
        },
        "parabolic_motion": {
          "$ref": "#/$defs/openWorldV2ParabolicScene"
        },
        "vertical_spring_oscillator": {
          "$ref": "#/$defs/verticalSpring"
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/referenceScene"
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "unsupported"
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol_id": {
            "const": "scene_default_v15"
          }
        },
        "required": [
          "protocol_id"
        ]
      },
      "then": {
        "properties": {
          "scenes": {
            "required": [
              "vertical_spring_oscillator"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sceneBase": {
      "type": "object",
      "required": [
        "type",
        "timeline",
        "spatial",
        "scoring"
      ]
    },
    "verticalSpring": {
      "allOf": [
        {
          "$ref": "#/$defs/sceneBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "evaluator_contract",
            "timeline",
            "spatial",
            "sam2",
            "quality",
            "period",
            "scoring",
            "subject_scoring",
            "identity",
            "topology",
            "content_weights"
          ],
          "properties": {
            "type": {
              "const": "vertical_spring_oscillator_v1"
            },
            "evaluator_contract": {
              "const": "robust_subject_v3"
            },
            "timeline": {
              "type": "object",
              "required": [
                "policy",
                "fps",
                "minimum_evaluation_fps",
                "minimum_source_fps",
                "duration_tolerance_s",
                "decode_policy"
              ],
              "properties": {
                "policy": {
                  "const": "physical_overlap_common_fps_v1"
                },
                "fps": {
                  "const": 24
                },
                "minimum_evaluation_fps": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minimum_source_fps": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "duration_tolerance_s": {
                  "type": "number",
                  "minimum": 0
                },
                "decode_policy": {
                  "const": "sequential_forward"
                }
              },
              "additionalProperties": false
            },
            "spatial": {
              "type": "object",
              "required": [
                "width",
                "height",
                "policy",
                "pad_value"
              ],
              "properties": {
                "width": {
                  "const": 480
                },
                "height": {
                  "const": 832
                },
                "policy": {
                  "const": "shared_reference_content_no_pad_v1"
                },
                "pad_value": {
                  "const": 0
                }
              },
              "additionalProperties": false
            },
            "sam2": {
              "type": "object",
              "required": [
                "model_id",
                "device"
              ],
              "properties": {
                "model_id": {
                  "const": "facebook/sam2.1-hiera-tiny"
                },
                "device": {
                  "enum": [
                    "auto",
                    "cpu",
                    "cuda"
                  ]
                }
              },
              "additionalProperties": false
            },
            "quality": {
              "type": "object",
              "required": [
                "minimum_mask_pixels",
                "minimum_mask_area_ratio",
                "maximum_mask_area_ratio",
                "minimum_anchor_area_ratio",
                "maximum_anchor_area_ratio",
                "minimum_valid_frame_ratio",
                "minimum_amplitude_px"
              ],
              "properties": {
                "minimum_mask_pixels": {
                  "type": "number",
                  "minimum": 0
                },
                "minimum_mask_area_ratio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maximum_mask_area_ratio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minimum_anchor_area_ratio": {
                  "type": "number",
                  "minimum": 0
                },
                "maximum_anchor_area_ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minimum_valid_frame_ratio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minimum_amplitude_px": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "period": {
              "type": "object",
              "required": [
                "minimum_s",
                "maximum_s",
                "minimum_period_correlation",
                "minimum_period_peak_prominence",
                "minimum_complete_cycles",
                "minimum_subharmonic_residual_px",
                "maximum_cadence_relative_deviation"
              ],
              "properties": {
                "minimum_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maximum_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minimum_period_correlation": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "minimum_period_peak_prominence": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minimum_complete_cycles": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minimum_subharmonic_residual_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maximum_cadence_relative_deviation": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            },
            "scoring": {
              "type": "object",
              "required": [
                "weights",
                "trajectory_scale",
                "amplitude_scale",
                "equilibrium_scale",
                "axis_drift_scale",
                "horizontal_trajectory_scale",
                "oscillation_amplitude_scale",
                "minimum_period_correlation",
                "minimum_period_peak_prominence",
                "minimum_complete_cycles",
                "minimum_subharmonic_residual_px"
              ],
              "properties": {
                "weights": {
                  "type": "object",
                  "required": [
                    "vertical_trajectory",
                    "period",
                    "amplitude_envelope",
                    "equilibrium_release_phase",
                    "vertical_axis_confinement",
                    "oscillation_evidence"
                  ],
                  "properties": {
                    "vertical_trajectory": {
                      "type": "number",
                      "minimum": 0
                    },
                    "period": {
                      "type": "number",
                      "minimum": 0
                    },
                    "amplitude_envelope": {
                      "type": "number",
                      "minimum": 0
                    },
                    "equilibrium_release_phase": {
                      "type": "number",
                      "minimum": 0
                    },
                    "vertical_axis_confinement": {
                      "type": "number",
                      "minimum": 0
                    },
                    "oscillation_evidence": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "trajectory_scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "amplitude_scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "equilibrium_scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "axis_drift_scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "horizontal_trajectory_scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "oscillation_amplitude_scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minimum_period_correlation": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "minimum_period_peak_prominence": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minimum_complete_cycles": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minimum_subharmonic_residual_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "subject_scoring": {
              "type": "object",
              "required": [
                "minimum_observed_pixels",
                "position_distance_scale",
                "canonical_crop_size",
                "boundary_tolerance_px",
                "weights",
                "case_weights",
                "parent_weights"
              ],
              "properties": {
                "minimum_observed_pixels": {
                  "type": "integer",
                  "minimum": 1
                },
                "position_distance_scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "canonical_crop_size": {
                  "type": "integer",
                  "minimum": 1
                },
                "boundary_tolerance_px": {
                  "type": "integer",
                  "minimum": 0
                },
                "weights": {
                  "type": "object",
                  "required": [
                    "position",
                    "shape",
                    "appearance"
                  ],
                  "properties": {
                    "position": {
                      "type": "number",
                      "minimum": 0
                    },
                    "shape": {
                      "type": "number",
                      "minimum": 0
                    },
                    "appearance": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "case_weights": {
                  "type": "object",
                  "required": [
                    "physics_state",
                    "subject"
                  ],
                  "properties": {
                    "physics_state": {
                      "type": "number",
                      "minimum": 0
                    },
                    "subject": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "parent_weights": {
                  "type": "object",
                  "required": [
                    "physics_state",
                    "conditioned_appearance"
                  ],
                  "properties": {
                    "physics_state": {
                      "type": "number",
                      "minimum": 0
                    },
                    "conditioned_appearance": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "identity": {
              "type": "object",
              "required": [
                "minimum_anchor_iou",
                "maximum_centroid_distance_radii",
                "minimum_anchor_area_ratio",
                "maximum_anchor_area_ratio"
              ],
              "properties": {
                "minimum_anchor_iou": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maximum_centroid_distance_radii": {
                  "type": "number",
                  "minimum": 0
                },
                "minimum_anchor_area_ratio": {
                  "type": "number",
                  "minimum": 0
                },
                "maximum_anchor_area_ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "topology": {
              "type": "object",
              "required": [
                "canny_low_threshold",
                "canny_high_threshold",
                "corridor_half_width_radius_ratio",
                "minimum_edge_pixels_per_row",
                "endpoint_height_radius_ratio",
                "boundary_exclusion_px",
                "connectivity_dilation_px",
                "minimum_corridor_height_radius_ratio",
                "minimum_connected_vertical_span_ratio",
                "minimum_reference_score"
              ],
              "properties": {
                "canny_low_threshold": {
                  "type": "number",
                  "minimum": 0
                },
                "canny_high_threshold": {
                  "type": "number",
                  "minimum": 0
                },
                "corridor_half_width_radius_ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minimum_edge_pixels_per_row": {
                  "type": "integer",
                  "minimum": 1
                },
                "endpoint_height_radius_ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "boundary_exclusion_px": {
                  "type": "integer",
                  "minimum": 0
                },
                "connectivity_dilation_px": {
                  "type": "integer",
                  "minimum": 0
                },
                "minimum_corridor_height_radius_ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minimum_connected_vertical_span_ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "minimum_reference_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            },
            "content_weights": {
              "type": "object",
              "required": [
                "physics_state",
                "subject",
                "topology"
              ],
              "properties": {
                "physics_state": {
                  "type": "number",
                  "minimum": 0
                },
                "subject": {
                  "type": "number",
                  "minimum": 0
                },
                "topology": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "generalMetrics": {
      "type": "object",
      "required": [
        "csti"
      ],
      "properties": {
        "csti": {
          "$ref": "#/$defs/csti"
        }
      },
      "additionalProperties": false
    },
    "csti": {
      "type": "object",
      "required": [
        "enabled",
        "algorithm",
        "temporal_tolerance_s",
        "condition_frame_policy",
        "initial_frames_excluded",
        "score_aggregation",
        "diagnostic_prefix_fractions",
        "case_aggregation",
        "timeline_policy",
        "mask_resolution"
      ],
      "oneOf": [
        {
          "required": ["spatial_tolerance_fraction"],
          "not": {
            "anyOf": [
              {"required": ["spatial_tolerance_policy"]},
              {"required": ["spatial_tolerance_radius_ratio"]}
            ]
          }
        },
        {
          "required": [
            "spatial_tolerance_policy",
            "spatial_tolerance_radius_ratio"
          ],
          "not": {"required": ["spatial_tolerance_fraction"]}
        }
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "algorithm": {
          "const": "exact_full_tube_edt"
        },
        "spatial_tolerance_fraction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spatial_tolerance_policy": {
          "const": "reference_tube_equivalent_diameter_v1"
        },
        "spatial_tolerance_radius_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "temporal_tolerance_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "condition_frame_policy": {
          "const": "exclude_initial_samples"
        },
        "initial_frames_excluded": {
          "type": "integer",
          "minimum": 1
        },
        "score_aggregation": {
          "const": "full_tube"
        },
        "diagnostic_prefix_fractions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"const": 0.25},
            {"const": 0.5},
            {"const": 0.75},
            {"const": 1.0}
          ]
        },
        "case_aggregation": {
          "const": "mean_gt_entities"
        },
        "timeline_policy": {
          "const": "physical_overlap"
        },
        "mask_resolution": {
          "const": "scene_analysis_native"
        }
      },
      "additionalProperties": false
    },
    "robustness": {
      "type": "object",
      "required": [
        "prediction_record_failure_policy",
        "prediction_media_failure_policy",
        "prediction_observation_failure_policy",
        "reference_failure_policy",
        "internal_failure_policy"
      ],
      "properties": {
        "prediction_record_failure_policy": {
          "const": "evaluated_zero"
        },
        "prediction_media_failure_policy": {
          "const": "evaluated_zero"
        },
        "prediction_observation_failure_policy": {
          "const": "evaluated_zero"
        },
        "reference_failure_policy": {
          "const": "unavailable"
        },
        "internal_failure_policy": {
          "const": "error"
        }
      },
      "additionalProperties": false
    },
    "subjectScoring": {
      "type": "object",
      "required": [
        "minimum_observed_pixels",
        "position_distance_scale",
        "canonical_crop_size",
        "boundary_tolerance_px",
        "weights",
        "case_weights",
        "parent_weights"
      ],
      "properties": {
        "minimum_observed_pixels": {
          "type": "integer",
          "minimum": 1
        },
        "position_distance_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "canonical_crop_size": {
          "type": "integer",
          "minimum": 8
        },
        "boundary_tolerance_px": {
          "type": "integer",
          "minimum": 1
        },
        "weights": {
          "type": "object",
          "required": [
            "position",
            "shape",
            "appearance"
          ],
          "properties": {
            "position": {
              "type": "number",
              "minimum": 0
            },
            "shape": {
              "type": "number",
              "minimum": 0
            },
            "appearance": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "case_weights": {
          "type": "object",
          "required": [
            "physics_state",
            "subject"
          ],
          "properties": {
            "physics_state": {
              "type": "number",
              "minimum": 0
            },
            "subject": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "parent_weights": {
          "type": "object",
          "required": [
            "physics_state",
            "conditioned_appearance"
          ],
          "properties": {
            "physics_state": {
              "type": "number",
              "minimum": 0
            },
            "conditioned_appearance": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "objectCentricScoring": {
      "type": "object",
      "required": [
        "assignment",
        "content_weights"
      ],
      "properties": {
        "assignment": {
          "type": "object",
          "required": [
            "minimum_match_position_similarity"
          ],
          "properties": {
            "minimum_match_position_similarity": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "content_weights": {
          "type": "object",
          "required": [
            "nbody_physics",
            "shape",
            "appearance"
          ],
          "properties": {
            "nbody_physics": {
              "type": "number",
              "minimum": 0
            },
            "shape": {
              "type": "number",
              "minimum": 0
            },
            "appearance": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "openWorldV2Scoring": {
      "type": "object",
      "required": [
        "assignment",
        "content_weights"
      ],
      "properties": {
        "assignment": {
          "type": "object",
          "required": [
            "minimum_match_position_similarity"
          ],
          "properties": {
            "minimum_match_position_similarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maximum_condition_identity_cost": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "initial_window_frames": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "content_weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "polar_distance": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "openWorldV2Visualization": {
      "type": "object",
      "required": [
        "enabled",
        "fps"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "external_root": {
          "type": "string",
          "minLength": 1,
          "deprecated": true,
          "description": "Legacy protocol provenance only; current writers always use the owning evaluation directory."
        },
        "external_root_env": {
          "type": "string",
          "minLength": 1,
          "deprecated": true,
          "description": "Legacy protocol provenance only; current writers do not read this environment variable."
        },
        "repository_link": {
          "type": "string",
          "minLength": 1,
          "deprecated": true,
          "description": "Legacy protocol provenance only; current manifests use evaluation-relative paths."
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "deprecated": true,
          "description": "Legacy protocol provenance only; evaluator versions are not directory components."
        },
        "mode": {
          "enum": [
            "all",
            "issues_only",
            "sampled",
            "off"
          ]
        },
        "layout": {
          "enum": [
            "side_by_side",
            "quad"
          ]
        },
        "codec": {
          "enum": [
            "h264",
            "avc1"
          ]
        },
        "sample_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "issue_score_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fps": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "panel_width": {
          "type": "integer",
          "minimum": 64
        },
        "panel_height": {
          "type": "integer",
          "minimum": 64
        },
        "footer_height": {
          "type": "integer",
          "minimum": 64
        }
      },
      "additionalProperties": false
    },
    "openWorldV2Scene": {
      "type": "object",
      "required": [
        "type",
        "observer_protocol",
        "evaluator_contract",
        "timeline",
        "spatial",
        "scoring",
        "subject_scoring",
        "object_centric_scoring",
        "visualization"
      ],
