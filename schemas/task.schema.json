{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vphysbench.org/schemas/task.schema.json",
  "title": "VPhysBench Task v1",
  "description": "Model-agnostic benchmark workload compiled against a dataset snapshot.",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "family",
    "dataset_id",
    "selection",
    "seeds",
    "evaluation"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "task_id": {"$ref": "#/$defs/safeIdentifier"},
    "family": {"enum": ["finetune_eval", "direct_eval"]},
    "dataset_id": {"$ref": "#/$defs/safeIdentifier"},
    "selection": {"type": "object"},
    "training": {
      "type": "object",
      "required": ["sampling"],
      "properties": {
        "sampling": {"$ref": "#/$defs/trainingSampling"}
      },
      "additionalProperties": false
    },
    "seeds": {
      "type": "object",
      "required": ["training", "inference"],
      "properties": {
        "training": {
          "type": "array",
          "items": {"type": "integer"},
          "uniqueItems": true
        },
        "inference": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["protocol", "reporting"],
      "properties": {
        "protocol": {"$ref": "#/$defs/safeIdentifier"},
        "reporting": {
          "type": "object",
          "required": [
            "primary_score",
            "breakdowns",
            "minimum_subgroup_jobs"
          ],
          "properties": {
            "primary_score": {"const": "overall_test"},
            "breakdowns": {
              "type": "array",
              "items": {
                "enum": ["generalization_regime", "ood_factor"]
              },
              "uniqueItems": true
            },
            "minimum_subgroup_jobs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"family": {"const": "finetune_eval"}},
        "required": ["family"]
      },
      "then": {
        "required": ["training"],
        "properties": {
          "selection": {
            "type": "object",
            "required": [
              "training_scene_ids",
              "evaluation_scene_ids",
              "test_regimes"
            ],
            "properties": {
              "training_scene_ids": {"$ref": "#/$defs/idSelector"},
              "evaluation_scene_ids": {"$ref": "#/$defs/idSelector"},
              "test_regimes": {"$ref": "#/$defs/regimeSelector"}
            },
            "additionalProperties": false
          },
          "seeds": {
            "properties": {
              "training": {"minItems": 1, "maxItems": 1}
            }
          }
        }
      },
      "else": {
        "not": {"required": ["training"]},
        "properties": {
          "selection": {
            "type": "object",
            "required": ["evaluation_scene_ids", "groups"],
            "properties": {
              "evaluation_scene_ids": {"$ref": "#/$defs/idSelector"},
              "groups": {"$ref": "#/$defs/idSelector"},
              "case_ids": {
                "type": "array",
                "items": {"$ref": "#/$defs/safeIdentifier"},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          },
          "seeds": {
            "properties": {
              "training": {"maxItems": 0}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "idSelector": {
      "oneOf": [
        {"const": "all"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/safeIdentifier"},
          "uniqueItems": true
        }
      ]
    },
    "regimeSelector": {
      "oneOf": [
        {"const": "all"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["id", "ood", "mixed"]},
          "uniqueItems": true
        }
      ]
    },
    "trainingSampling": {
      "type": "object",
      "required": [
        "strategy",
        "epoch_size",
        "seed_source",
        "audit_required"
      ],
      "properties": {
        "strategy": {"const": "scene_balanced_resampling_v1"},
        "epoch_size": {"const": "selected_training_case_count"},
        "seed_source": {"const": "training_seed"},
        "audit_required": {"const": true}
      },
      "additionalProperties": false
    }
  }
}
