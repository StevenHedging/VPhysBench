{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model-agnostic train/test benchmark Task",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "family",
    "dataset_id",
    "dataset_view",
    "selection",
    "seeds",
    "evaluation"
  ],
  "properties": {
    "schema_version": {"const": "4.0"},
    "task_id": {"$ref": "#/$defs/safeIdentifier"},
    "family": {"enum": ["finetune_eval", "direct_eval"]},
    "dataset_id": {"$ref": "#/$defs/safeIdentifier"},
    "dataset_view": {"enum": ["view_a", "view_b"]},
    "selection": {"type": "object"},
    "seeds": {
      "type": "object",
      "required": ["training", "inference"],
      "properties": {
        "training": {
          "type": "array",
          "items": {"type": "integer"},
          "uniqueItems": true
        },
        "inference": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["protocol", "reporting"],
      "properties": {
        "protocol": {"$ref": "#/$defs/safeIdentifier"},
        "reporting": {
          "type": "object",
          "required": [
            "primary_score",
            "breakdowns",
            "minimum_subgroup_jobs"
          ],
          "properties": {
            "primary_score": {"const": "overall_test"},
            "breakdowns": {
              "type": "array",
              "items": {
                "enum": ["generalization_regime", "ood_factor"]
              },
              "uniqueItems": true
            },
            "minimum_subgroup_jobs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"family": {"const": "finetune_eval"}},
        "required": ["family"]
      },
      "then": {
        "properties": {
          "dataset_view": {"const": "view_a"},
          "selection": {
            "type": "object",
            "required": ["test_regimes"],
            "oneOf": [
              {
                "required": ["scene_ids"],
                "not": {
                  "anyOf": [
                    {"required": ["training_scene_ids"]},
                    {"required": ["evaluation_scene_ids"]}
                  ]
                }
              },
              {
                "required": [
                  "training_scene_ids",
                  "evaluation_scene_ids"
                ],
                "not": {"required": ["scene_ids"]}
              }
            ],
            "properties": {
              "scene_ids": {"$ref": "#/$defs/idSelector"},
              "training_scene_ids": {"$ref": "#/$defs/idSelector"},
              "evaluation_scene_ids": {"$ref": "#/$defs/idSelector"},
              "test_regimes": {"$ref": "#/$defs/regimeSelector"}
            },
            "additionalProperties": false
          },
          "seeds": {
            "properties": {
              "training": {"minItems": 1, "maxItems": 1}
            }
          }
        }
      },
      "else": {
        "properties": {
          "dataset_view": {"const": "view_b"},
          "selection": {
            "type": "object",
            "required": ["groups"],
            "oneOf": [
              {
                "required": ["scene_ids"],
                "not": {"required": ["evaluation_scene_ids"]}
              },
              {
                "required": ["evaluation_scene_ids"],
                "not": {"required": ["scene_ids"]}
              }
            ],
            "properties": {
              "scene_ids": {"$ref": "#/$defs/idSelector"},
              "evaluation_scene_ids": {"$ref": "#/$defs/idSelector"},
              "groups": {"$ref": "#/$defs/idSelector"},
              "case_ids": {
                "type": "array",
                "items": {"$ref": "#/$defs/safeIdentifier"},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          },
          "seeds": {
            "properties": {
              "training": {"maxItems": 0}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "idSelector": {
      "oneOf": [
        {"const": "all"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/safeIdentifier"},
          "uniqueItems": true
        }
      ]
    },
    "regimeSelector": {
      "oneOf": [
        {"const": "all"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["id", "ood", "mixed"]},
          "uniqueItems": true
        }
      ]
    }
  }
}
