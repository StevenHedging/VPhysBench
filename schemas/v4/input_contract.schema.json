{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baseline Adaptation Input Contract",
  "type": "object",
  "required": [
    "schema_version",
    "generation_mode",
    "text",
    "media_channels",
    "physics_channels",
    "asset_access"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generation_mode": {
      "enum": ["t2v", "i2v", "v2v", "hybrid"]
    },
    "text": {
      "type": "object",
      "required": ["required", "binding"],
      "properties": {
        "required": {"const": true},
        "binding": {
          "type": "string",
          "pattern": "^native_inputs\\."
        }
      },
      "additionalProperties": false
    },
    "media_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "binding"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["image", "video"]},
          "origin": {
            "enum": ["dataset_asset", "derived_artifact"]
          },
          "asset_key": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "^(?:assets\\.)?(?:reference_video|physics_reference_video|source_video)(?::.*)?$"
            }
          },
          "binding": {
            "type": "string",
            "pattern": "^native_inputs\\."
          },
          "artifact_provenance": {
            "$ref": "#/$defs/artifactProvenance"
          }
        },
        "oneOf": [
          {
            "required": ["asset_key"],
            "properties": {
              "origin": {"const": "dataset_asset"}
            },
            "not": {"required": ["artifact_provenance"]}
          },
          {
            "required": ["origin", "artifact_provenance"],
            "properties": {
              "origin": {"const": "derived_artifact"}
            },
            "not": {"required": ["asset_key"]}
          }
        ],
        "additionalProperties": false
      }
    },
    "physics_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "representation",
          "binding",
          "transport",
          "used_parameters"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "representation": {"type": "string", "minLength": 1},
          "binding": {
            "type": "string",
            "pattern": "^native_inputs\\."
          },
          "transport": {"type": "string", "minLength": 1},
          "used_parameters": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "artifact_provenance": {
            "$ref": "#/$defs/artifactProvenance"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "transport": {"const": "artifact_ref"}
              },
              "required": ["transport"]
            },
            "then": {"required": ["artifact_provenance"]},
            "else": {"not": {"required": ["artifact_provenance"]}}
          }
        ],
        "additionalProperties": false
      }
    },
    "asset_access": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "^(?:assets\\.)?(?:reference_video|physics_reference_video|source_video)(?::.*)?$"
        }
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "artifactProvenance": {
      "type": "object",
      "required": [
        "content_sha256",
        "producer_fingerprint",
        "source_digest"
      ],
      "properties": {
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "producer_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generation_mode": {"const": "t2v"}
        },
        "required": ["generation_mode"]
      },
      "then": {
        "properties": {
          "media_channels": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "generation_mode": {"const": "i2v"}
        },
        "required": ["generation_mode"]
      },
      "then": {
        "properties": {
          "media_channels": {
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {"kind": {"const": "image"}},
              "required": ["kind"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generation_mode": {"const": "v2v"}
        },
        "required": ["generation_mode"]
      },
      "then": {
        "properties": {
          "media_channels": {
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {"kind": {"const": "video"}},
              "required": ["kind"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generation_mode": {"const": "hybrid"}
        },
        "required": ["generation_mode"]
      },
      "then": {
        "properties": {
          "media_channels": {
            "minItems": 2,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {"kind": {"const": "image"}},
                  "required": ["kind"]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"kind": {"const": "video"}},
                  "required": ["kind"]
                }
              }
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
