{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baseline adapter configuration",
  "type": "object",
  "required": ["schema_version", "baseline_id", "adapter", "input_view", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "baseline_id": {"type": "string"},
    "adapter": {"enum": ["dummy", "command", "wan22_lora"]},
    "input_view": {"type": "string"},
    "capabilities": {
      "type": "object",
      "required": ["train", "finetune", "generate"],
      "properties": {"train": {"type": "boolean"}, "finetune": {"type": "boolean"}, "generate": {"type": "boolean"}}
    },
    "commands": {"type": "object"}
  }
}
